# Backend (Render) — copy to .env for local runs, or set these in the Render
# dashboard. The Python code reads the process environment directly; it never
# loads this file, so exporting the values is what matters. No real secret
# belongs in this file or in git.

GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.5-flash

# Long random string, e.g. `openssl rand -hex 32`. Enter the same value in the
# app's Settings sheet; it is sent as `Authorization: Bearer …`.
RAVAN_API_TOKEN=replace-with-a-long-random-token

# CORS. Pin to the Pages origin and the APK's WebView origin. "*" is allowed but
# means any site may call the endpoint.
ALLOWED_ORIGINS=https://YOURNAME.github.io,https://localhost

# Deterministic canned replies for UI tests; makes no Gemini calls.
RAVAN_MOCK=0
RAVAN_MOCK_DELAY=0.15
CHAT_TIMEOUT_S=35
RATE_LIMIT_PER_MIN=30
SESSION_TTL_S=1800
MAX_SESSIONS=200
MAX_HISTORY=24
MAX_TEXT_CHARS=2000
ASSISTANT_NAME=RAVAN
USER_NAME=

# Frontend build. Used by scripts/build-web.mjs and the Pages workflow; this is
# a public URL, not a secret.
RAVAN_BACKEND_URL=https://ravan-ai.onrender.com
