{
  "name": "ravan-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "RAVAN AI — Capacitor Android shell around the existing Gemini assistant",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync android",
    "open:android": "cap open android",
    "add:android": "cap add android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
